Name:           lumeneh
Version:        @VERSION@
Release:        1%{?dist}
Summary:        lumenEh native GTK3 markdown viewer

License:        GPL-3.0-or-later
URL:            @URL@
Source0:        lumeneh-%{version}.tar.gz

BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  pkgconfig
BuildRequires:  gtk3-devel

Requires:       gtk3

%description
lumenEh is a native GTK3 markdown viewer for local and remote (SSH) files.

%prep
%autosetup -n lumeneh-%{version}

%build
# config.mk is machine-local and not in the source archive
./configure --prefix=%{_prefix}
make %{?_smp_mflags}

%install
rm -rf %{buildroot}
make install DESTDIR=%{buildroot} PREFIX=%{_prefix} DESKTOP_SHORTCUT=0

%files
%{_bindir}/lumeneh
%{_datadir}/applications/lumeneh.desktop
%{_datadir}/icons/hicolor/256x256/apps/lumeneh.png

%changelog
* Thu Jan 01 1970 lumenEh Packager <noreply@example.com> - @VERSION@-1
- Initial package
