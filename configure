#!/bin/bash
# configure script for lumenEh

# Default variables
PREFIX="/usr/local"
CC=${CC:-gcc}
CFLAGS=${CFLAGS:-"-Wall -Wextra -O2 -g"}

# Print help
show_help() {
    echo "Usage: ./configure [OPTIONS]"
    echo "Options:"
    echo "  --prefix=PREFIX    Install architecture-independent files in PREFIX [Default: /usr/local]"
    echo "  --bindir=DIR       User executables [PREFIX/bin]"
    echo "  --datadir=DIR      Read-only architecture-independent data [PREFIX/share]"
    echo "  --help             Print this message"
}

# Parse command line arguments
for arg in "$@"; do
    case "$arg" in
        --prefix=*) PREFIX="${arg#*=}" ;;
        --bindir=*) BINDIR="${arg#*=}" ;;
        --datadir=*) DATADIR="${arg#*=}" ;;
        --help) show_help; exit 0 ;;
        *) echo "Unknown option: $arg"; exit 1 ;;
    esac
done

BINDIR=${BINDIR:-$PREFIX/bin}
DATADIR=${DATADIR:-$PREFIX/share}
APPSDIR="$DATADIR/applications"

echo "Checking system environment..."

# Detect OS
if [ -f /etc/os-release ]; then
    . /etc/os-release
    echo "  OS: $NAME $VERSION"
else
    echo "  OS: $(uname -s)"
fi

echo "Checking for C compiler..."
if ! command -v $CC >/dev/null 2>&1; then
    echo "Error: C compiler ($CC) not found."
    exit 1
fi
echo "  Compiler: $CC"

echo "Checking for pkg-config..."
if ! command -v pkg-config >/dev/null 2>&1; then
    echo "Error: pkg-config is required but not installed."
    exit 1
fi
echo "  Found pkg-config."

echo "Checking for gtk+-3.0..."
if ! pkg-config --exists gtk+-3.0; then
    echo "Error: gtk+-3.0 development files are not installed."
    echo "Please install libgtk-3-dev or equivalent."
    exit 1
fi
GTK_CFLAGS=$(pkg-config --cflags gtk+-3.0)
GTK_LIBS=$(pkg-config --libs gtk+-3.0)
echo "  Found gtk+-3.0"

echo "Checking for ssh..."
if ! command -v ssh >/dev/null 2>&1; then
    echo "Warning: ssh binary not found. Remote SSH feature will not work."
else
    echo "  Found ssh."
fi

echo "Generating config.mk..."

cat <<EOF > config.mk
# Generated by ./configure
CC = $CC
CFLAGS = $CFLAGS $GTK_CFLAGS
LDFLAGS = $GTK_LIBS

PREFIX = $PREFIX
bindir = $BINDIR
datadir = $DATADIR
applicationsdir = $APPSDIR
EOF

echo "Configuration complete!"
echo ""
echo "You can now compile the project by running:"
echo "  make"
echo ""
echo "To install the application, run:"
echo "  sudo make install"
